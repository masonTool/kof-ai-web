{
  "name": "kof97-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "拳皇'97 的 Web 复刻（程序化美术，60Hz 逐帧模拟）",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm run test",
    "art": "node scripts/sprites/build-sheet.mjs",
    "art:preview": "node scripts/sprites/preview.mjs",
    "art:base": "node scripts/sprites/gen-base.mjs",
    "art:poses": "node scripts/sprites/gen-poses.mjs",
    "art:all": "node scripts/sprites/gen-all.mjs",
    "continue:worktree": "node .continue/hooks/worktree.mjs",
    "art:check": "node scripts/sprites/check-assets.mjs",
    "art:stages": "node scripts/sprites/gen-stages.mjs",
    "art:stages:build": "node scripts/sprites/build-stages.mjs",
    "art:portraits": "node scripts/sprites/build-portraits.mjs"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vite": "^7.1.12",
    "vitest": "^3.2.4"
  }
}
